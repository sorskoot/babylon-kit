{
    "name": "@sorskoot/babylon-kit",
    "version": "0.1.0",
    "description": "A lightweight, modular game engine/tools layer built on top of Babylon.js",
    "type": "module",
    "main": "dist/engine/index.js",
    "types": "dist/engine/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/engine/index.d.ts",
            "import": "./dist/engine/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc",
        "prepack": "npm run test && npm run build",
        "pack:check": "npm pack --dry-run",
        "pack:tarball": "npm pack",
        "prepublishOnly": "npm run test && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "dev": "vite",
        "lint": "eslint src/",
        "docs": "typedoc"
    },
    "keywords": [
        "babylonjs",
        "game-engine",
        "ecs",
        "3d",
        "webgl",
        "sorskoot"
    ],
    "license": "MIT",
    "dependencies": {
        "@babylonjs/core": "^8.56.1",
        "@babylonjs/gui": "^8.56.1",
        "@babylonjs/loaders": "^8.56.1"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vitest": "^4.1.0",
        "vite": "^8.0.1",
        "@vitest/coverage-v8": "^4.1.0",
        "typedoc": "^0.28.18"
    }
}
